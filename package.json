    "email:catcher": "docker compose up -d mailpit",
    "email:brevo:test": "node scripts/send-brevo-test.js",
    "openapi:generate": "node scripts/generate-openapi.js",
    "postman:generate": "node scripts/generate-postman.js",
    "test:email:api": "NODE_ENV=test mocha 'src/test/emailApiNoDb.cjs' --exit",
    "email:sandbox": "node scripts/email-sandbox.js"
  },
  "devDependencies": {
