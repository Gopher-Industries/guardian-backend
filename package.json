  "scripts": {
    "start": "nodemon src/server.js",
    "dev": "nodemon src/app.js",
    "test": "NODE_ENV=test mocha 'src/test/**/*.cjs' --recursive --exit",
    "test:coverage": "NODE_ENV=test nyc mocha 'src/test/**/*.cjs' --recursive --exit",
    "coverage:check": "NODE_ENV=test nyc --check-coverage --branches 65 --lines 79 --functions 80 --statements 77 mocha 'src/test/**/*.cjs' --recursive --exit",
